# =============================================================================
# Free-generalist service topology — LOCAL vs REMOTE profiles.
#
# Checked in (NO secrets). Sourced by run_services.sh and the run_local_*.sh
# launchers; loaded by Python via load_dotenv("infra/services.env").
# Secrets (ZAI_API_KEY, Mongo creds, Chrome paths, ...) stay in .env.
#
# Ports are identical for both profiles. Only the *_ENDPOINT values change.
# Services always co-locate (all on this machine OR all on the remote laptop),
# so service-to-service links stay localhost; only the agent/dialer side reads
# the *_ENDPOINT values below.
#
# Activate a profile: uncomment exactly ONE block (LOCAL or REMOTE) below.
# =============================================================================

# ---- Shared ports (identical for both profiles) ----
MCP_PORT=7000
API_PORT=8000
PROXY_PORT=4000

# =============================================================================
# LOCAL profile — MCP + API + proxy all run on THIS machine.
# Agents/dialers on this machine point at 127.0.0.1.
# =============================================================================
DEPLOY_PROFILE=local
MCP_SERVER_ENDPOINT=http://127.0.0.1:7000/mcp
API_SERVER_ENDPOINT=http://127.0.0.1:8000
PROXY_ENDPOINT=http://127.0.0.1:4000/v1

# =============================================================================
# REMOTE profile — agents run locally, but MCP + API + proxy sit on a DIFFERENT
# laptop. Replace <REMOTE_HOST> with that laptop's LAN/VPN IP, then
# comment out the LOCAL block above and uncomment this one. The services must
# bind 0.0.0.0 on the remote host (the launchers already do).
# =============================================================================
# DEPLOY_PROFILE=remote
# MCP_SERVER_ENDPOINT=http://<REMOTE_HOST>:7000/mcp
# API_SERVER_ENDPOINT=http://<REMOTE_HOST>:8000
# PROXY_ENDPOINT=http://<REMOTE_HOST>:4000/v1
